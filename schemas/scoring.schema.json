{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eli-llm-bench:schema:scoring",
  "title": "Eli LLM Bench scoring",
  "type": "object",
  "required": ["version", "status", "total", "categories", "checks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "frozen"] },
    "total": { "const": 100 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "points"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "points": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "points",
          "requirements",
          "requires",
          "title",
          "passText",
          "failText"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "category": { "type": "string" },
          "points": { "type": "number", "exclusiveMinimum": 0 },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "title": { "type": "string", "minLength": 1 },
          "passText": { "type": "string", "minLength": 1 },
          "failText": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
