{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eli-llm-bench:schema:judge-result",
  "title": "Eli LLM Bench judge result",
  "type": "object",
  "required": ["judgeId", "visualExperience", "engineering", "total", "observations", "publicCommentary"],
  "properties": {
    "judgeId": { "type": "string" },
    "visualExperience": { "type": "number", "minimum": 0, "maximum": 10 },
    "engineering": { "type": "number", "minimum": 0, "maximum": 10 },
    "total": { "type": "number", "minimum": 0, "maximum": 20 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "impact", "statement", "anchor"],
        "properties": {
          "category": { "enum": ["visual_experience", "engineering"] },
          "impact": { "type": "number", "maximum": 0 },
          "statement": { "type": "string", "minLength": 1 },
          "anchor": { "$ref": "#/$defs/anchor" }
        },
        "additionalProperties": false
      }
    },
    "publicCommentary": {
      "type": "object",
      "required": ["summary", "whatWorked", "whatNeedsImprovement", "scoreRationale"],
      "properties": {
        "summary": { "type": "string", "minLength": 40, "maxLength": 1200 },
        "whatWorked": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/publicPoint" }
        },
        "whatNeedsImprovement": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/publicPoint" }
        },
        "scoreRationale": { "type": "string", "minLength": 40, "maxLength": 1200 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "publicPoint": {
      "type": "object",
      "required": ["statement", "anchor"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
        "anchor": { "$ref": "#/$defs/anchor" }
      },
      "additionalProperties": false
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "requirementId"],
          "properties": {
            "type": { "const": "requirement" },
            "requirementId": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path", "line"],
          "properties": {
            "type": { "const": "file" },
            "path": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "screenshot" },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "checkId"],
          "properties": {
            "type": { "const": "check" },
            "checkId": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
