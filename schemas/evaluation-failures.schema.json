{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eli-llm-bench:schema:evaluation-failures",
  "title": "Sanitized Eli LLM Bench evaluation failures",
  "type": "object",
  "required": ["runId", "round", "generatedAt", "summary", "failures"],
  "properties": {
    "runId": { "type": "string" },
    "round": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "manualReviewRequired": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["checksTotal", "passed", "failed", "skipped"],
      "properties": {
        "checksTotal": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "skipped": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "code", "area", "expected", "observed"],
        "properties": {
          "phase": {
            "enum": ["install", "database", "build", "startup", "api", "browser", "stack"]
          },
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "area": { "type": "string", "maxLength": 80 },
          "expected": { "type": "string", "maxLength": 1000 },
          "observed": { "type": "string", "maxLength": 1000 },
          "evidence": {
            "type": "object",
            "properties": {
              "command": { "type": "string", "maxLength": 300 },
              "exitCode": { "type": ["integer", "null"] },
              "stderrTail": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 500 }
              },
              "request": { "type": "object" },
              "response": { "type": "object" },
              "route": { "type": "string", "maxLength": 300 },
              "consoleErrors": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 500 }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
