{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eli-llm-bench:schema:result",
  "title": "Eli LLM Bench result",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "benchmarkVersion",
    "model",
    "resultStatus",
    "terminationReason",
    "score",
    "timing",
    "cost",
    "usage",
    "checks",
    "links"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "benchmarkVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "required": ["id", "provider", "harness", "reasoning"],
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "harness": { "type": "string" },
        "reasoning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resultStatus": { "enum": ["COMPLETE", "INVALID"] },
    "terminationReason": {
      "enum": [
        "completed",
        "turn_limit",
        "time_limit",
        "cost_limit",
        "infra_invalid",
        "user_cancelled"
      ]
    },
    "score": {
      "type": "object",
      "required": ["earned", "maximum"],
      "properties": {
        "earned": { "type": "number", "minimum": 0, "maximum": 100 },
        "maximum": { "const": 100 }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["startedAt", "endedAt", "buildTotalMs", "evaluationTotalMs"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "buildTotalMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "evaluationTotalMs": { "$ref": "#/$defs/nonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["currency", "participant", "limit", "source"],
      "properties": {
        "currency": { "const": "USD" },
        "participant": { "type": "number", "minimum": 0 },
        "limit": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["turns", "toolCalls", "tokens"],
      "properties": {
        "turns": { "$ref": "#/$defs/nonNegativeInteger" },
        "toolCalls": { "$ref": "#/$defs/nonNegativeInteger" },
        "tokens": {
          "type": "object",
          "required": ["input", "output", "reasoning", "cached"],
          "properties": {
            "input": { "$ref": "#/$defs/nonNegativeInteger" },
            "output": { "$ref": "#/$defs/nonNegativeInteger" },
            "reasoning": { "$ref": "#/$defs/nonNegativeInteger" },
            "cached": { "$ref": "#/$defs/nonNegativeInteger" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "pointsAvailable", "pointsAwarded", "summary"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "pointsAvailable": { "type": "number", "minimum": 0 },
          "pointsAwarded": { "type": "number", "minimum": 0 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "report": { "type": "string" },
        "video": { "type": ["string", "null"] },
        "project": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
