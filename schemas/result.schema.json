{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eli-llm-bench:schema:result",
  "title": "Eli LLM Bench result",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "benchmarkVersion",
    "model",
    "deliveryStatus",
    "resultStatus",
    "terminationReason",
    "score",
    "timing",
    "cost",
    "usage",
    "automaticChecks",
    "judging",
    "links"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "benchmarkVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "required": ["id", "provider", "harness", "reasoning"],
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "harness": { "type": "string" },
        "reasoning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deliveryStatus": {
      "anyOf": [
        { "enum": ["1P", "2P", "FAIL"] },
        { "type": "null" }
      ]
    },
    "resultStatus": {
      "enum": ["COMPLETE", "PARTIAL", "INVALID"]
    },
    "terminationReason": {
      "enum": [
        "completed",
        "turn_limit",
        "time_limit",
        "cost_limit",
        "infra_invalid",
        "user_cancelled"
      ]
    },
    "score": {
      "type": "object",
      "required": ["automatic", "subjective", "recoveryPenalty", "total"],
      "properties": {
        "automatic": { "type": "number", "minimum": 0, "maximum": 80 },
        "subjective": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 20 },
            { "type": "null" }
          ]
        },
        "recoveryPenalty": { "type": "number", "minimum": -100, "maximum": 0 },
        "total": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": [
        "startedAt",
        "endedAt",
        "buildRound1Ms",
        "recoveryMs",
        "buildTotalMs",
        "evaluationTotalMs",
        "benchmarkTotalMs"
      ],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "buildRound1Ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "recoveryMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "buildTotalMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "evaluationTotalMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "benchmarkTotalMs": { "$ref": "#/$defs/nonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": [
        "currency",
        "participant",
        "judging",
        "total",
        "limit",
        "limitAppliesTo"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "participant": { "type": "number", "minimum": 0 },
        "judging": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "limit": { "type": "number", "exclusiveMinimum": 0 },
        "limitAppliesTo": { "const": "participant" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["turns", "toolCalls", "tokens"],
      "properties": {
        "turns": { "$ref": "#/$defs/nonNegativeInteger" },
        "toolCalls": { "$ref": "#/$defs/nonNegativeInteger" },
        "tokens": {
          "type": "object",
          "required": ["input", "output", "reasoning", "cached"],
          "properties": {
            "input": { "$ref": "#/$defs/nonNegativeInteger" },
            "output": { "$ref": "#/$defs/nonNegativeInteger" },
            "reasoning": { "$ref": "#/$defs/nonNegativeInteger" },
            "cached": { "$ref": "#/$defs/nonNegativeInteger" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "maxBuildTimeMinutes",
        "maxRecoveryTimeMinutes",
        "maxTurns",
        "maxParticipantCostUsd"
      ],
      "properties": {
        "maxBuildTimeMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "maxRecoveryTimeMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "maxParticipantCostUsd": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["operatingSystem", "node", "npm", "openCode"],
      "properties": {
        "operatingSystem": { "type": "string" },
        "node": { "type": "string" },
        "npm": { "type": "string" },
        "openCode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "automaticChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "pointsAvailable", "pointsAwarded", "summary"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "pointsAvailable": { "type": "number", "minimum": 0 },
          "pointsAwarded": { "type": "number", "minimum": 0 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "technicalDetails": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "additionalProperties": false
      }
    },
    "judging": {
      "type": "object",
      "properties": {
        "status": { "enum": ["complete", "partial", "not_run"] },
        "validJudgeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reserveUsed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "report": { "type": "string" },
        "video": { "type": ["string", "null"] },
        "project": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
