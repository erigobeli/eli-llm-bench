{
  "name": "crmbench-modelo",
  "private": true,
  "version": "1.0.0",
  "description": "CRMBench Modelo - Mini CRM (clientes, negócios e pipeline)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:setup": "tsx scripts/db-setup.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "rimraf dist && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "24.0.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "cross-env": "7.0.3",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
