{
  "name": "crmbench-modelo",
  "version": "1.0.0",
  "description": "Mini CRM com clientes, negócios e pipeline (CRMBench Modelo)",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.app.json && vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "db:setup": "tsx src/server/setup-db.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
