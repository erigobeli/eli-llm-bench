{
  "name": "crmbench-modelo",
  "private": true,
  "version": "1.0.0",
  "description": "CRMBench Modelo - Mini CRM full-stack (React + Vite + Express + SQLite)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:setup": "npm run build:server && node dist/server/setup.js",
    "build:server": "rimraf dist/server && tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "dev:web": "vite",
    "dev:server": "npm run build:server && node dist/server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
