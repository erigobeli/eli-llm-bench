{
  "name": "crmbench-modelo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRMBench Modelo - Mini CRM full-stack (Eli LLM Bench v1)",
  "scripts": {
    "db:setup": "tsx src/server/setup.ts",
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
