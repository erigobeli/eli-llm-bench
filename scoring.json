    { "id": "ux.responsive", "category": "ux_accessibility", "points": 1, "requirements": ["REQ-UX-RESPONSIVE"], "requires": ["setup.start"], "critical": false },
    { "id": "ux.accessibility", "category": "ux_accessibility", "points": 1, "requirements": ["REQ-UX-ACCESSIBILITY"], "requires": ["setup.start"], "critical": false },
    { "id": "ux.console", "category": "ux_accessibility", "points": 1, "requirements": ["REQ-UX-CONSOLE"], "requires": ["setup.start", "auth.login"], "critical": false }
