{
  "$schema": "./schemas/scoring.schema.json",
  "version": "0.2-draft",
  "status": "draft",
  "totals": {
    "automatic": 80,
    "subjective": 20,
    "maximum": 100
  },
  "recoveryPenalty": {
    "1P": 0,
    "2P": -5,
    "minimumFinalScore": 0
  },
  "automaticCategories": [
    {
      "id": "setup",
      "name": "Instalação, banco, build e inicialização",
      "points": 8,
      "rationale": "Sem uma aplicação executável, os demais comportamentos não podem ser comprovados."
    },
    {
      "id": "authentication",
      "name": "Autenticação e proteção",
      "points": 8,
      "rationale": "Login e isolamento das rotas são parte do núcleo do produto."
    },
    {
      "id": "clients",
      "name": "Clientes",
      "points": 12,
      "rationale": "Clientes são o primeiro recurso principal do CRM."
    },
    {
      "id": "opportunities",
      "name": "Oportunidades",
      "points": 12,
      "rationale": "Oportunidades são o segundo recurso principal e dependem da integridade do vínculo com clientes."
    },
    {
      "id": "pipeline",
      "name": "Pipeline e persistência de etapa",
      "points": 10,
      "rationale": "O fluxo visual persistente diferencia o desafio de um CRUD simples."
    },
    {
      "id": "dashboard",
      "name": "Dashboard calculado",
      "points": 8,
      "rationale": "Agregações coerentes comprovam leitura e cálculo a partir do banco."
    },
    {
      "id": "validation_security",
      "name": "Validação, integridade e segurança",
      "points": 12,
      "rationale": "Protege dados, sessões e reprodutibilidade da aplicação."
    },
    {
      "id": "ux_accessibility",
      "name": "Fluxos de interface, responsividade e acessibilidade",
      "points": 10,
      "rationale": "Verifica usabilidade objetiva sem pontuar gosto visual."
    }
  ],
  "subjectiveCategories": [
    {
      "id": "visual_experience",
      "name": "Experiência visual",
      "points": 10
    },
    {
      "id": "engineering",
      "name": "Arquitetura e engenharia",
      "points": 10
    }
  ],
  "checks": [
