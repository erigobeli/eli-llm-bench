    { "id": "setup.database", "category": "setup", "points": 2, "requirements": ["REQ-SETUP-DATABASE"], "requires": ["setup.install"], "critical": false },
    { "id": "setup.build", "category": "setup", "points": 2, "requirements": ["REQ-SETUP-BUILD"], "requires": ["setup.install"], "critical": false },
    { "id": "setup.start", "category": "setup", "points": 2, "requirements": ["REQ-SETUP-START"], "requires": ["setup.install", "setup.database", "setup.build"], "critical": true },
    { "id": "setup.stack", "category": "setup", "points": 1, "requirements": ["REQ-SETUP-STACK"], "requires": ["setup.install", "setup.build"], "critical": false },

