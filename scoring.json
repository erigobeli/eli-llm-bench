    { "id": "opportunities.delete", "category": "opportunities", "points": 1, "requirements": ["REQ-OPPORTUNITY-DELETE"], "requires": ["setup.start", "auth.login"], "critical": true },
    { "id": "opportunities.search_filter", "category": "opportunities", "points": 2, "requirements": ["REQ-OPPORTUNITY-SEARCH-FILTER"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "opportunities.relationship", "category": "opportunities", "points": 2, "requirements": ["REQ-OPPORTUNITY-RELATIONSHIP"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "opportunities.validation", "category": "opportunities", "points": 2, "requirements": ["REQ-OPPORTUNITY-VALIDATION"], "requires": ["setup.start", "auth.login"], "critical": false },

    { "id": "pipeline.columns", "category": "pipeline", "points": 2, "requirements": ["REQ-PIPELINE-COLUMNS"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "pipeline.stage_change", "category": "pipeline", "points": 3, "requirements": ["REQ-PIPELINE-STAGE-CHANGE"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "pipeline.persistence", "category": "pipeline", "points": 5, "requirements": ["REQ-PIPELINE-PERSISTENCE"], "requires": ["setup.start", "auth.login"], "critical": true },

    { "id": "dashboard.counts", "category": "dashboard", "points": 3, "requirements": ["REQ-DASHBOARD-COUNTS"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "dashboard.values", "category": "dashboard", "points": 3, "requirements": ["REQ-DASHBOARD-VALUES"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "dashboard.by_stage", "category": "dashboard", "points": 2, "requirements": ["REQ-DASHBOARD-BY-STAGE"], "requires": ["setup.start", "auth.login"], "critical": false },

    { "id": "security.error_contract", "category": "validation_security", "points": 2, "requirements": ["REQ-SAFE-ERROR-CONTRACT"], "requires": ["setup.start"], "critical": false },
    { "id": "security.unknown_fields", "category": "validation_security", "points": 2, "requirements": ["REQ-SAFE-UNKNOWN-FIELDS"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "security.immutable_fields", "category": "validation_security", "points": 2, "requirements": ["REQ-SAFE-IMMUTABLE-FIELDS"], "requires": ["setup.start", "auth.login"], "critical": false },
    { "id": "data.db_path", "category": "validation_security", "points": 2, "requirements": ["REQ-DATA-DB-PATH"], "requires": ["setup.install"], "critical": false },
    { "id": "data.migrations", "category": "validation_security", "points": 1, "requirements": ["REQ-DATA-MIGRATIONS"], "requires": ["setup.install"], "critical": false },
    { "id": "security.secrets", "category": "validation_security", "points": 1, "requirements": ["REQ-SECURITY-SECRETS"], "requires": [], "critical": false },
    { "id": "data.format_order", "category": "validation_security", "points": 2, "requirements": ["REQ-SAFE-FORMAT-ORDER", "REQ-SAFE-LOCALE"], "requires": ["setup.start", "auth.login"], "critical": false },

