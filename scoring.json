    { "id": "clients.update", "category": "clients", "points": 2, "requirements": ["REQ-CLIENT-UPDATE"], "requires": ["setup.start", "auth.login"], "critical": true },
    { "id": "clients.delete", "category": "clients", "points": 1, "requirements": ["REQ-CLIENT-DELETE"], "requires": ["setup.start", "auth.login"], "critical": true },
    { "id": "clients.search_filter", "category": "clients", "points": 2, "requirements": ["REQ-CLIENT-SEARCH-FILTER"], "requires": ["setup.start", "auth.login"], "critical": false },
